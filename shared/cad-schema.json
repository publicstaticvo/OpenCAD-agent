  {"type":"object","required":["op","design"],"additionalProperties":false,"properties":{"op":{"const":"assembly_check"},"design":{"$ref":"assembly"}}},
  {"type":"object","required":["op","id"],"additionalProperties":false,"properties":{"op":{"const":"create_body"},"id":{"$ref":"id"}}},
  {"type":"object","required":["op","id","body","plane","origin"],"additionalProperties":false,"properties":{"op":{"const":"create_sketch"},"id":{"$ref":"id"},"body":{"$ref":"id"},"plane":{"enum":["XY","XZ","YZ"]},"origin":{"$ref":"point3"}}},
  {"type":"object","required":["op","sketch","geometryId","geometry"],"additionalProperties":false,"properties":{"op":{"const":"add_geometry"},"sketch":{"$ref":"id"},"geometryId":{"type":"integer","minimum":0,"maximum":255},"geometry":{"$ref":"geometry"}}},
  {"type":"object","required":["op","sketch","name","kind","args"],"additionalProperties":false,"properties":{"op":{"const":"add_constraint"},"sketch":{"$ref":"id"},"name":{"$ref":"id"},"kind":{"enum":["Coincident","Horizontal","Vertical","Distance","DistanceX","DistanceY","Diameter","Radius","Equal"]},"args":{"type":"array","minItems":1,"maxItems":5,"items":{"$ref":"number"}}}},
  {"type":"object","required":["op","id","sketch","length"],"additionalProperties":false,"properties":{"op":{"enum":["pad","pocket"]},"id":{"$ref":"id"},"sketch":{"$ref":"id"},"length":{"$ref":"positive"}}},
  {"type":"object","required":["op","feature","parameter","value"],"additionalProperties":false,"properties":{"op":{"const":"set_parameter"},"feature":{"$ref":"id"},"parameter":{"$ref":"id"},"value":{"$ref":"number"}}}

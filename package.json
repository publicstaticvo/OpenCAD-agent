{
  "name": "cad-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:cad": "python -m unittest discover -s worker/tests -v",
    "test:e2e": "playwright test",
    "doctor": "python scripts/doctor.py",
    "verify:pi": "tsx scripts/verify-pi.ts",
    "dev": "tsx gateway/main.ts",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "test:eval": "tsx scripts/eval-text-to-cad.ts --offline",
    "test:live": "tsx scripts/eval-text-to-cad.ts"
  },
  "dependencies": {
    "openai": "7.19.0",
    "partial-json": "0.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "typebox": "1.3.27",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "node": "24.22.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
